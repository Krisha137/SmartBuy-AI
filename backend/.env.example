# SmartBuy AI Environment Configuration Example
# Copy to .env and adjust values for local development

# Security
SECRET_KEY=your-django-secret-key-here
DJANGO_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartbuy_ai

# CORS Settings (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# AI Provider API Keys (Server-Side Only — Never expose to client)
AI_API_KEY=your-gemini-api-key-here
